<?xml version="1.0"?>
<ruleset name="EasyCache">
    <description>PSR-12 coding standard for EasyCache</description>

    <file>src</file>
    <file>tests</file>
    <file>config</file>
    <file>bin/easycache-prune</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- @method annotations on the facade cannot be wrapped -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>src/Laravel/Facades/*</exclude-pattern>
    </rule>
</ruleset>
